# Copy these values into .env.local when running against your-sofia-api staging.

EXPO_PUBLIC_DEFAULT_ENV=staging
EXPO_PUBLIC_STAGING_API_URL=https://staging-your.sofia.bg

# Google Maps API Key for Android
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_ANDROID_API_KEY_HERE

# Sentry DSN (safe to embed in the client bundle; leave empty to disable Sentry)
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only - used to upload source maps and debug symbols. Never commit this.
SENTRY_AUTH_TOKEN=
