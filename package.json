{
  "name": "your-sofia-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "prebuild": "expo prebuild",
    "dev": "cross-env EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "dev:staging": "cross-env EXPO_NO_TELEMETRY=1 EXPO_PUBLIC_DEFAULT_ENV=staging expo start --dev-client",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "android": "expo run:android",
    "android:staging": "EXPO_PUBLIC_DEFAULT_ENV=staging expo run:android",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:ios",
    "ios:staging": "EXPO_PUBLIC_DEFAULT_ENV=staging REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:ios",
    "test": "jest",
    "update:development": "eas update --channel development",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "detox:android:build": "detox build --configuration android.emu.release",
    "detox:android:test": "detox test --configuration android.emu.release",
    "detox:ios:build": "detox build --configuration ios.sim.release",
    "detox:ios:test": "detox test --configuration ios.sim.release"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/sofia-sans": "^0.4.3",
    "@expo/metro-runtime": "^58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^6.0.2",
    "@lucide/lab": "^0.7.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "^58.0.21",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "^58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-detox-config-plugin": "^13.1.0",
    "expo-dev-client": "~58.0.17",
    "expo-device": "^58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "^58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "^58.0.20",
    "expo-notifications": "^58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-unified-push": "^0.6.0",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.5.11",
    "lucide-react-native": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.29.11",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "simple-icons": "^16.36.0",
    "victory-native": "^42.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "baseline-browser-mapping": "^2.11.34",
    "cross-env": "^10.1.0",
    "detox": "^20.51.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "glob": "^14.0.3",
    "husky": "^9.1.7",
    "inflight": "^1.0.6",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "test-renderer": "^1.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "modulePathIgnorePatterns": [
      "e2e"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia"
    ],
    "overrides": {
      "fast-uri": "^3.1.1",
      "brace-expansion": "^5.0.6",
      "node-forge": ">=1.4.0",
      "undici": "^7.24.0",
      "tar": ">=7.5.16",
      "@xmldom/xmldom": "~0.8.12",
      "lodash": ">=4.18.0",
      "flatted": ">=3.4.2",
      "minimatch": ">=9.0.1",
      "glob@<9>minimatch": "^10.2.6",
      "shell-quote": ">=1.8.4",
      "form-data": "^4.0.6",
      "ws": ">=8.21.0",
      "markdown-it": ">=12.3.2",
      "@tootallnate/once": ">=2.0.1",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1 <12",
      "js-yaml": ">=4.2.0"
    }
  }
}
