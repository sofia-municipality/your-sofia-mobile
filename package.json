{
  "name": "your-sofia-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "cross-env EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "dev:staging": "cross-env EXPO_NO_TELEMETRY=1 EXPO_PUBLIC_DEFAULT_ENV=staging expo start --dev-client",
    "generate:api": "openapi-generator-cli generate -i api.yaml -g typescript-axios -o src/api --additional-properties=supportsES6=true,withInterfaces=true",
    "generate:mock": "openapi-generator-cli generate -i api.yaml -g nodejs-express-server -o mock-server",
    "install:mock": "pnpm --dir mock-server install",
    "test": "pnpm generate:mock && pnpm install:mock && jest --config package.json",
    "build:web": "openapi-generator-cli generate -i api.yaml -g typescript-axios -o src/api --additional-properties=supportsES6=true,withInterfaces=true && expo export --platform web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "android": "expo run:android",
    "android:staging": "EXPO_PUBLIC_DEFAULT_ENV=staging expo run:android",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:ios",
    "ios:staging": "EXPO_PUBLIC_DEFAULT_ENV=staging REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:ios",
    "e2e:build:ios": "detox build --configuration ios.sim.release",
    "e2e:test:ios": "detox test --configuration ios.sim.release --config e2e/jest.config.js --cleanup",
    "e2e:test:android": "detox test --configuration android.emulator.release --config e2e/jest.config.js --loglevel verbose",
    "e2e:debug_test:ios": "detox test --inspect-brk --configuration ios.sim.release",
    "e2e:build:android": "detox build --configuration android.emulator.release",
    "e2e:debug_test:android": "detox test --inspect-brk --configuration android.emulator.release",
    "update:development": "eas update --channel development",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/sofia-sans": "^0.4.3",
    "@expo/metro-runtime": "^57.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.7.1",
    "@lucide/lab": "^0.2.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "axios": "^1.19.0",
    "expo": "^57.0.11",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "^57.0.9",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "^57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "^57.0.8",
    "expo-notifications": "^57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-unified-push": "^0.4.0",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "i18next": "^25.5.2",
    "lucide-react-native": "^0.544.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.27.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "simple-icons": "^15.16.1",
    "victory-native": "^41.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.4",
    "cors": "^2.8.6",
    "baseline-browser-mapping": "^2.11.12",
    "cross-env": "^10.1.0",
    "detox": "20.51.4",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "glob": "^12.0.0",
    "husky": "^9.1.7",
    "inflight": "^1.0.6",
    "jest": "~29.7.0",
    "swagger-ui-express": "^5.0.1",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    },
    "modulePathIgnorePatterns": [
      "helpers"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "detox"
    ],
    "overrides": {
      "fast-uri": "^3.1.1",
      "brace-expansion": "^5.0.6",
      "node-forge": ">=1.4.0",
      "undici": "^7.24.0",
      "tar": ">=7.5.16",
      "@xmldom/xmldom": "~0.8.12",
      "lodash": ">=4.18.0",
      "flatted": ">=3.4.2",
      "minimatch": ">=9.0.1",
      "shell-quote": ">=1.8.4",
      "form-data": "^4.0.6",
      "ws": ">=8.21.0",
      "markdown-it": ">=12.3.2",
      "@tootallnate/once": ">=2.0.1",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1 <12",
      "js-yaml": ">=4.2.0"
    }
  }
}
